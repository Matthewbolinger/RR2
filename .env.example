# Same-origin Vercel intake route. This value appears in generated HTML.
# Never expose an AccuLynx key or private notification webhook here.
FORM_ENDPOINT=/api/quote/

# Server-only AccuLynx credentials and account-specific routing IDs.
ACCULYNX_API_KEY=
ACCULYNX_CONTACT_TYPE_ID=
ACCULYNX_LEAD_SOURCE_ID=

# Optional AccuLynx account-specific classification IDs.
ACCULYNX_JOB_CATEGORY_ID=
ACCULYNX_WORK_TYPE_ID=
ACCULYNX_TRADE_TYPE_ID=

# Comma-separated exact browser origins allowed to submit.
FORM_ALLOWED_ORIGINS=https://www.raccoonrestoration.com,https://raccoonrestoration.com

# Optional server-only Slack Incoming Webhook. Never expose this in browser code.
SLACK_LEADS_WEBHOOK_URL=

# Reserved analytics decision fields. The current templates do not read these
# values; setting them will not activate tracking. Implement only after the
# tracking-continuity and consent review.
GA_MEASUREMENT_ID=
GTM_CONTAINER_ID=
META_PIXEL_ID=

# Production origin used for canonical URLs and sitemap generation.
SITE_URL=https://www.raccoonrestoration.com
